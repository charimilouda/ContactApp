{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="login-container">
    <div class="login-form">
        <h1 class="text-center">Inscription</h1>

        {# Affichage du message de succès dans un modal #}
        {% for message in app.flashes('success') %}
            <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="successModalLabel">Succès</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            {{ message }}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        {# Affichage du formulaire #}
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_row(form.nom, { 'attr': { 'placeholder': 'Entrez votre nom' } }) }}
            </div>
            <div class="form-group">
                {{ form_row(form.prenom, { 'attr': { 'placeholder': 'Entrez votre prénom' } }) }}
            </div>
            <div class="form-group">
                {{ form_row(form.email, { 'attr': { 'placeholder': 'Entrez votre email' } }) }}
            </div>
            <div class="form-group">
                {{ form_row(form.motDePasse, { 'attr': { 'placeholder': 'Choisissez un mot de passe' } }) }}
            </div>

            <div class="form-group">
                {{ form_row(form.save, { 'attr': { 'class': 'submit-btn' } }) }}
            </div>
        {{ form_end(form) }}

        <!-- Lien vers la page de Login -->
        <div class="signup-link">
            <p>Vous avez déjà un compte ? <a href="{{ path('app_utilisateur_login') }}">Se connecter</a></p>
        </div>
    </div>
</div>

{# Activation du modal via JavaScript #}
<script>
    var successModal = new bootstrap.Modal(document.getElementById('successModal'));
    successModal.show();
</script>

{% endblock %}
