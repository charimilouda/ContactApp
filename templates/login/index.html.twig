{% extends 'base.html.twig' %}

{% block title %}Page de connexion{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="login-form">
            <h1 class="text-center">Connexion</h1>

            {% if app.flashes('error') %}
                <div class="alert alert-danger">
                    {% for message in app.flashes('error') %}
                        <p>{{ message }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form action="{{ path('app_utilisateur_authenticate') }}" method="POST">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="Entrez votre email" required>
                </div>

                <div class="form-group">
                    <label for="motDePasse">Mot de passe</label>
                    <input type="password" id="motDePasse" name="motDePasse" placeholder="Entrez votre mot de passe" required>
                </div>

                <button type="submit" class="submit-btn">Se connecter</button>
            </form>

            <!-- Lien vers la page d'inscription -->
            <div class="signup-link">
                <p>Pas encore inscrit ? <a href="{{ path('app_user_register') }}">Créez un compte</a></p>
            </div>
        </div>
    </div>
{% endblock %}
